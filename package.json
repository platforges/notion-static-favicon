{
  "name": "notion-static-favicon",
  "version": "2.0.0",
  "private": true,
  "description": "Chrome extension that prevents Notion's favicon from changing to match the current page.",
  "repository": "github:platforges/notion-static-favicon",
  "homepage": "https://github.com/platforges/notion-static-favicon",
  "bugs": "https://github.com/platforges/notion-static-favicon/issues",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "zip": "npm run build && node scripts/zip.mjs",
    "publish:cws": "chrome-webstore-upload --source release/$npm_package_name-$npm_package_version.zip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "chrome-webstore-upload-cli": "^4.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
