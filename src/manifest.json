{
  "manifest_version": 3,
  "name": "Notion Static Favicon",
  "description": "Prevents the Notion browser tab icon from changing to match the current page.",
  "homepage_url": "https://github.com/platforges/notion-static-favicon",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notion.so/*",
        "https://www.notion.so/*",
        "https://notion.com/*",
        "https://www.notion.com/*",
        "https://app.notion.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["base-favicon.ico"],
      "matches": [
        "https://notion.so/*",
        "https://www.notion.so/*",
        "https://notion.com/*",
        "https://www.notion.com/*",
        "https://app.notion.com/*"
      ]
    }
  ]
}
